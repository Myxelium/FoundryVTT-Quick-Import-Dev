<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="quick">
        <i class="fa-solid fa-image"></i> {{localize 'QUICKBATTLEMAP.TabQuick'}}
    </a>
    <a class="item" data-action="tab" data-group="primary" data-tab="uvtt">
        <i class="fa-solid fa-file-import"></i> {{localize 'QUICKBATTLEMAP.TabUvtt'}}
    </a>
</nav>

<section class="tab quick-tab" data-group="primary" data-tab="quick">
    <p class="notes quick-battlemap-instructions">{{localize 'QUICKBATTLEMAP.DropInstructions'}}</p>
    <div class="area"><div id="dropZone">{{localize 'QUICKBATTLEMAP.DropZone'}}</div></div>
    <p class="notes quick-battlemap-instructions">{{localize 'QUICKBATTLEMAP.DropInstructionsMore'}}</p>

    <div class="form-group">
        <label>{{localize 'QUICKBATTLEMAP.BackgroundStatus'}}</label>
        <div class="form-fields">
            <span class="background-status"><span class="status-value">❌</span></span>
        </div>
    </div>
    <div class="form-group">
        <label>{{localize 'QUICKBATTLEMAP.WallDataStatus'}}</label>
        <div class="form-fields">
            <span class="wall-data-status"><span class="status-value">❌</span></span>
        </div>
    </div>
    <div class="form-group">
        <label>{{localize 'QUICKBATTLEMAP.Options'}}</label>
        <div class="form-fields ebm-no-grid">
            <label class="checkbox">
                <input type="checkbox" class="ebm-no-grid" name="noGrid" {{checked noGrid}}>
                <span>{{localize 'QUICKBATTLEMAP.NoGridLabel'}}</span>
            </label>
        </div>
        <p class="hint">{{localize 'QUICKBATTLEMAP.NoGridHint'}}</p>
    </div>
    <div class="form-group progress-group" style="display:none">
        <label>{{localize 'QUICKBATTLEMAP.ProgressLabel'}}</label>
        <div class="form-fields ebm-progress-row">
            <div class="ebm-spinner" aria-hidden="true"><i class="fa-solid fa-spinner fa-spin"></i></div>
            <span class="ebm-progress-text">{{localize 'QUICKBATTLEMAP.ProgressIdle'}}</span>
        </div>
        <p class="notes">{{localize 'QUICKBATTLEMAP.ProgressNote'}}</p>
    </div>
    <footer class="sheet-footer flexrow">
        <button type="button" class="reset-button" data-action="resetQuick">
            <i class="fa-solid fa-rotate-left"></i> {{localize 'QUICKBATTLEMAP.Reset'}}
        </button>
        <button type="button" class="create-scene-button" data-action="createScene" disabled>
            <i class="fa-solid fa-save"></i> {{localize 'QUICKBATTLEMAP.CreateScene'}}
        </button>
    </footer>
</section>

<section class="tab uvtt-tab" data-group="primary" data-tab="uvtt">
    <p class="notes quick-battlemap-instructions">{{localize 'QUICKBATTLEMAP.UvttInstructions'}}</p>

    <div class="form-group">
        <label>{{localize 'QUICKBATTLEMAP.SceneName'}}</label>
        <div class="form-fields">
            <input type="text" name="sceneName">
        </div>
    </div>

    <div class="form-group" data-tooltip="{{localize 'QUICKBATTLEMAP.StorageHint'}}">
        <label>{{localize 'QUICKBATTLEMAP.StorageType'}}</label>
        <div class="form-fields">
            <select name="source" class="source-selector">
                {{selectOptions dataSources selected=defaultSource}}
            </select>
        </div>
    </div>

    <div class="form-group" data-tooltip="{{localize 'QUICKBATTLEMAP.WebpHint'}}">
        <label>{{localize 'QUICKBATTLEMAP.ConvertWebp'}}</label>
        <div class="form-fields">
            <input type="checkbox" class="convert-to-webp" name="toWebp" {{checked webpConversion}}>
        </div>
    </div>

    <div class="form-group" data-tooltip="{{localize 'QUICKBATTLEMAP.CustomPpiHint'}}">
        <label>{{localize 'QUICKBATTLEMAP.CustomPpi'}}</label>
        <div class="form-fields">
            <input type="checkbox" data-action="usePPI" name="useCustomPixelsPerGrid" {{checked useCustomPixelsPerGrid}}>
        </div>
    </div>

    <div class="form-group custom-gridPPI-section" style="display:none">
        <label>{{localize 'QUICKBATTLEMAP.PixelsPerGrid'}}</label>
        <div class="form-fields">
            <range-picker name="customPixelsPerGrid" value="{{customPixelsPerGrid}}" min="50" max="256" step="1">
                <input type="range" min="50" max="256" step="1" value="{{customPixelsPerGrid}}">
                <input type="number" min="50" max="256" step="1" value="{{customPixelsPerGrid}}">
            </range-picker>
        </div>
    </div>

    <div class="form-group" data-tooltip="{{localize 'QUICKBATTLEMAP.PathHint'}}">
        <label>{{localize 'QUICKBATTLEMAP.UploadPath'}}</label>
        <div class="form-fields">
            <file-picker type="folder" name="path">
                <input type="text" name="path" value="{{path}}">
                <button type="button" class="fa-solid fa-file-import fa-fw icon"></button>
            </file-picker>
        </div>
    </div>
    <div class="warning path notification error" style="display:none">{{localize 'QUICKBATTLEMAP.PathWarning'}}</div>

    <div class="form-group" data-tooltip="{{localize 'QUICKBATTLEMAP.FidelityHint'}}">
        <label>{{localize 'QUICKBATTLEMAP.Fidelity'}}</label>
        <div class="form-fields">
            <input class="fidelity-input" type="range" min="1" max="6" step="1" name="fidelity" value="{{fidelity}}">
        </div>
    </div>
    <div class="warning fidelity notification error" style="display:none">{{localize 'QUICKBATTLEMAP.FidelityWarning'}}</div>

    <div class="form-group" data-tooltip="{{localize 'QUICKBATTLEMAP.ObjectWallsHint'}}">
        <label>{{localize 'QUICKBATTLEMAP.ObjectWalls'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="objectWalls" checked>
        </div>
    </div>

    <div class="form-group" data-tooltip="{{localize 'QUICKBATTLEMAP.PaddingHint'}}">
        <label>{{localize 'QUICKBATTLEMAP.Padding'}}</label>
        <div class="form-fields">
            <range-picker name="padding" value="{{padding}}" min="0" max="0.5" step="0.05">
                <input type="range" min="0" max="0.5" step="0.05" value="{{padding}}">
                <input type="number" min="0" max="0.5" step="0.05" value="{{padding}}">
            </range-picker>
        </div>
    </div>

    <div class="levels">
        <p class="notes">{{localize 'QUICKBATTLEMAP.UploadUvtt'}}</p>
        <div class="level">
            <input type="text" name="levelName0" class="level-name" placeholder="{{localize 'QUICKBATTLEMAP.LevelName'}}">
            <input class="file-input" type="file" name="file0" accept=".dd2vtt,.df2vtt,.uvtt,.json">
            <div></div>
        </div>
        <p class="add-file"><a data-action="addFile"><i class="fa-solid fa-plus"></i> {{localize 'QUICKBATTLEMAP.AddLevel'}}</a></p>

        <fieldset class="multi-mode-section" style="display:none">
            <legend>{{localize 'QUICKBATTLEMAP.MultiFileOptions'}}</legend>
            <div class="form-group">
                <label>{{localize 'QUICKBATTLEMAP.WallsAroundFiles'}}</label>
                <input type="checkbox" name="wallsAroundFiles" {{checked wallsAroundFiles}}>
            </div>
            <div class="form-group">
                <label>{{localize 'QUICKBATTLEMAP.LayoutMode'}}</label>
                <div class="form-fields">
                    <select name="mode">
                        {{selectOptions multiImageModes selected=multiImageMode}}
                    </select>
                </div>
            </div>
            <div class="form-group stacked">
                <label>{{localize 'QUICKBATTLEMAP.ImageFileName'}}</label>
                <input type="text" name="imageFileName">
            </div>
            <div class="info levels-note notification" style="display:none">{{localize 'QUICKBATTLEMAP.LevelsSameSize'}}</div>
        </fieldset>
    </div>

    <fieldset class="advanced-options">
        <legend>{{localize 'QUICKBATTLEMAP.Advanced'}}</legend>
        <div class="form-group conversion-quality">
            <label data-tooltip="{{localize 'QUICKBATTLEMAP.WebpQualityHint'}}">{{localize 'QUICKBATTLEMAP.WebpQuality'}}</label>
            <div class="form-fields">
                <range-picker name="webpQuality" value="{{webpQuality}}" min="0.1" max="1" step="0.1">
                    <input type="range" min="0.1" max="1" step="0.1" value="{{webpQuality}}">
                    <input type="number" min="0.1" max="1" step="0.1" value="{{webpQuality}}">
                </range-picker>
            </div>
        </div>
        <div class="form-group" data-tooltip="{{localize 'QUICKBATTLEMAP.OffsetHint'}}">
            <label>{{localize 'QUICKBATTLEMAP.Offset'}}</label>
            <div class="form-fields">
                <input type="number" min="-3" max="3" step="0.1" name="offset" value="{{offset}}">
            </div>
        </div>
        <div class="form-group s3-section" style="display:none">
            <label>{{localize 'QUICKBATTLEMAP.Bucket'}}</label>
            <div class="form-fields">
                <select name="bucket">
                    {{selectOptions bucketOptions selected=s3Bucket}}
                </select>
            </div>
        </div>
    </fieldset>

    <footer class="sheet-footer flexrow">
        <button type="submit" class="import-uvtt-button">
            <i class="fa-solid fa-download"></i> {{localize 'QUICKBATTLEMAP.ImportUvtt'}}
        </button>
    </footer>
</section>
